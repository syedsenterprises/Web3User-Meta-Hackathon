{
  "name": "web3user-permission-lab",
  "version": "0.1.0-rc.1",
  "description": "Off-chain authorization and policy governance engine with SQLite persistence, Ed25519 signed artifacts, and atomic single-use replay protection for Web3 actions",
  "private": true,
  "license": "Apache-2.0",
  "author": "Syed Shahed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedsenterprises/Web3User-Meta-Hackathon.git"
  },
  "bugs": {
    "url": "https://github.com/syedsenterprises/Web3User-Meta-Hackathon/issues"
  },
  "homepage": "https://github.com/syedsenterprises/Web3User-Meta-Hackathon#readme",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/demo",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:persistent-replay": "tsc --project tsconfig.demo.json && node dist/demo/persistent-replay-demo.js",
    "preview:server": "node scripts/preview-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.15",
    "etcd3": "^1.1.2",
    "pg": "^8.23.1"
  }
}
